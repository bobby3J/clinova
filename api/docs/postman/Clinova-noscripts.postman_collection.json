                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"deck_id\": {{deck_id}},\n  \"question\": \"Signs of postpartum hemorrhage?\",\n  \"answer\": \"Blood loss >500mL vaginal, hypotension, tachycardia\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/flashcards/cards",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "flashcards",
                                "cards"
                            ]
                        }
                    }
                },
                {
                    "name": "Due Cards (Student)",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/flashcards/due",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "flashcards",
                                "due"
                            ]
                        },
                        "description": "A card with no progress row is always due. Run this before and after reviewing a card to see it disappear/reappear."
                    }
                },
                {
                    "name": "Review Card \u2014 quality 5 (Student)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"quality\": 5\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/flashcards/{{flashcard_id}}/review",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "flashcards",
                                "{{flashcard_id}}",
                                "review"
                            ]
                        },
                        "description": "SM-2: quality 0-5. First review at quality 5 should return interval_days: 1, ease_factor: 2.6, status: 201 (new progress row created)."
                    }
                },
                {
                    "name": "Review Card \u2014 quality 1, a failure (Student)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"quality\": 1\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/flashcards/{{flashcard_id}}/review",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "flashcards",
                                "{{flashcard_id}}",
                                "review"
                            ]
                        },
                        "description": "Quality < 3 resets interval_days to 1 but leaves ease_factor untouched \u2014 SM-2 doesn't punish ease on a single bad day."
                    }
                }
            ]
        },
