{
    "info": {
        "_postman_id": "c1in0va-0000-0000-0000-000000000001",
        "name": "Clinova API (no scripts)",
        "description": "Every endpoint across all six backend domains (Users, StudyLibrary, Flashcards, SoundLibrary, StudySessions, Admin). Pair with the Clinova - Admin and Clinova - Student environment files. See docs/postman/README.md for setup and a recommended walkthrough order.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{token}}",
                "type": "string"
            }
        ]
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://127.0.0.1:8000/api"
        },
        {
            "key": "topic_id",
            "value": "1"
        },
        {
            "key": "subject_id",
            "value": "1"
        },
        {
            "key": "material_id",
            "value": "1"
        },
        {
            "key": "deck_id",
            "value": "1"
        },
        {
            "key": "flashcard_id",
            "value": "1"
        },
        {
            "key": "sound_id",
            "value": "1"
        },
        {
            "key": "study_session_id",
            "value": "1"
        },
        {
            "key": "user_id",
            "value": "2"
        }
    ],
    "item": [
        {
            "name": "Auth",
            "description": "Register/login use real session auth, not the collection's Bearer default \u2014 each has auth overridden to None here. Everything else in this collection uses the Bearer token from your active environment.",
            "item": [
                {
                    "name": "Register",
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"New Student\",\n  \"email\": \"newstudent@example.com\",\n  \"password\": \"password\",\n  \"password_confirmation\": \"password\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/register",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "register"
                            ]
                        }
                    }
                },
                {
                    "name": "Login (via Bearer-token workflow \u2014 see README)",
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "login"
                            ]
                        },
                        "description": "This is the REAL cookie-session endpoint \u2014 it will 500 in Postman unless you do the CSRF-cookie dance described in the README. For day-to-day testing, mint a Bearer token via Tinker instead (also in the README) and skip this request entirely."
                    }
                },
                {
                    "name": "Current User (/api/user)",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/user",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "user"
                            ]
                        },
                        "description": "Good first call to run after setting a token \u2014 confirms the Bearer token in your active environment actually authenticates, and shows you which user you're acting as."
                    }
                },
                {
                    "name": "Logout",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/logout",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "logout"
                            ]
                        }
                    }
                },
                {
                    "name": "Forgot Password",
                    "request": {
                        "auth": {
                            "type": "noauth"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"test@example.com\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/forgot-password",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "forgot-password"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "StudyLibrary",
            "item": [
                {
                    "name": "List Subjects",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/study-library/subjects",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "study-library",
                                "subjects"
                            ]
                        }
                    }
                },
                {
                    "name": "Create Subject (admin)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Community Health Nursing\",\n  \"track\": \"nursing\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/study-library/subjects",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "study-library",
                                "subjects"
                            ]
                        },
                        "description": "Run as the admin environment. On success, auto-saves the new id into {{subject_id}} for the next request."
                    }
                },
                {
                    "name": "List Topics",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/study-library/topics?subject_id={{subject_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "study-library",
                                "topics"
                            ],
                            "query": [
                                {
                                    "key": "subject_id",
                                    "value": "{{subject_id}}"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Create Topic (admin)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"subject_id\": {{subject_id}},\n  \"name\": \"Postpartum Hemorrhage\",\n  \"order\": 1\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/study-library/topics",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "study-library",
                                "topics"
                            ]
                        },
                        "description": "Uses {{subject_id}} from the previous request. Auto-saves the new id into {{topic_id}}."
                    }
                },
                {
                    "name": "List Materials in a Topic",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/study-library/topics/{{topic_id}}/materials",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "study-library",
                                "topics",
                                "{{topic_id}}",
                                "materials"
                            ]
                        },
                        "description": "Run once as Student (only published materials), then switch the active environment to Admin and run again (drafts included too)."
                    }
                },
                {
                    "name": "Create Study Material (admin)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"topic_id\": {{topic_id}},\n  \"type\": \"note\",\n  \"title\": \"Managing PPH: First Response\",\n  \"body\": \"Et et sapiente vel...\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/study-library/materials",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "study-library",
                                "materials"
                            ]
                        },
                        "description": "type must be note|video|audio. A note needs 'body'; video/audio need 'url' instead. Expect 201 (wasRecentlyCreated) and status: draft."
                    }
                },
                {
                    "name": "Get Single Material",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/study-library/materials/{{material_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "study-library",
                                "materials",
                                "{{material_id}}"
                            ]
                        },
                        "description": "As Student: 403 if the material is still draft \u2014 that's StudyMaterialPolicy::view() working, not a bug."
                    }
                },
                {
                    "name": "Update Material (admin)",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"title\": \"Managing PPH: Updated Title\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/study-library/materials/{{material_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "study-library",
                                "materials",
                                "{{material_id}}"
                            ]
                        }
                    }
                },
                {
                    "name": "Publish Material (admin)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/study-library/materials/{{material_id}}/publish",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "study-library",
                                "materials",
                                "{{material_id}}",
                                "publish"
                            ]
                        },
                        "description": "Flips status to published AND writes an admin_activity_logs row via AdminActionPerformed. Check Admin > Activity Log after running this."
                    }
                },
                {
                    "name": "Delete Material (admin)",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/study-library/materials/{{material_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "study-library",
                                "materials",
                                "{{material_id}}"
                            ]
                        }
                    }
                }
            ]
        },
