                {
                    "name": "Finish Session \u2014 completed (Student)",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"actual_minutes\": 50,\n  \"completed\": true\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/study-sessions/{{study_session_id}}/finish",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "study-sessions",
                                "{{study_session_id}}",
                                "finish"
                            ]
                        },
                        "description": "completed: true fires FocusSessionCompleted \u2014 call Auth > Current User before and after to watch streak_count change."
                    }
                },
                {
                    "name": "Finish Session \u2014 exited early (Student)",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"actual_minutes\": 8,\n  \"completed\": false\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/study-sessions/{{study_session_id}}/finish",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "study-sessions",
                                "{{study_session_id}}",
                                "finish"
                            ]
                        },
                        "description": "Still saves the row (Sheet 03's rule) but does NOT touch the streak \u2014 compare streak_count before/after against the 'completed: true' version."
                    }
                }
            ]
        },
        {
            "name": "Admin",
            "description": "Every request in this folder needs the Admin environment active \u2014 role:admin is enforced at the route-group level, so a Student token gets 403 on all of these.",
            "item": [
                {
                    "name": "List Students",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/admin/users",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "admin",
                                "users"
                            ]
                        }
                    }
                },
                {
                    "name": "Suspend User",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/admin/users/{{user_id}}/suspend",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "admin",
                                "users",
                                "{{user_id}}",
                                "suspend"
                            ]
                        },
                        "description": "{{user_id}} defaults to 2, the seeded Test Student. After running this, that student's token (if you minted one) stops authenticating \u2014 try Auth > Current User with the Student environment active."
                    }
                },
                {
                    "name": "Reactivate User",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/admin/users/{{user_id}}/reactivate",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "admin",
                                "users",
                                "{{user_id}}",
                                "reactivate"
                            ]
                        }
                    }
                },
                {
                    "name": "Broadcast Announcement",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"title\": \"New content live\",\n  \"body\": \"Check out the new Postpartum Hemorrhage deck.\",\n  \"track\": \"nursing\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/admin/announcements",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "admin",
                                "announcements"
                            ]
                        },
                        "description": "'track' is optional \u2014 drop it to broadcast to every student regardless of track. Never reaches the broadcasting admin's own notifications."
                    }
                },
                {
                    "name": "Activity Log",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/admin/activity-log",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "admin",
                                "activity-log"
                            ]
                        },
                        "description": "Run this after publishing a material/deck or suspending a user \u2014 each should show up here via AdminActionPerformed, with zero manual wiring on the triggering domain's side."
                    }
