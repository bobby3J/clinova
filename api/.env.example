APP_NAME=Clinova
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# The React+Vite frontends' dev origins (admin console + student app, two
# separate projects sharing this one API). FRONTEND_URLS (comma-separated)
# is what config/cors.php actually reads; FRONTEND_URL is kept only as
# that config's fallback if FRONTEND_URLS is unset. SANCTUM_STATEFUL_DOMAINS
# is a separate check — combined with these, it decides whether Sanctum
# treats a request as session-authenticatable at all. See
# docs/API_REFERENCE.md §2 before changing any of these.
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5174
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5174

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# AiPractice's QuestionGenerator — free-tier key from aistudio.google.com.
# Server-side only; never exposed to either frontend. See
# docs/ARCHITECTURE.md's "AiPractice" section. Falls back to the
# non-AI TemplateQuestionGenerator if unset or if a call fails.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
