# ${PORT} is substituted by entrypoint.sh at container start — Render
# assigns this dynamically and the service must bind to whatever it gives,
# not a fixed port. Defaults to 8080 for local `docker run` without Render.
server {
    listen ${PORT};
    server_name _;
    root /app/public;
    index index.php;

    client_max_body_size 25M;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass 127.0.0.1:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        # Matches the Dockerfile's max_execution_time=120 — nginx's own
        # default (60s) would otherwise cut the connection to php-fpm
        # before PHP's own limit even applies, same class of bug.
        fastcgi_read_timeout 120s;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
