# The Laravel API's origin (no path) — needed separately from VITE_API_URL
# because the CSRF-cookie handshake (GET /sanctum/csrf-cookie) is NOT under
# /api. See api/docs/API_REFERENCE.md §2 before changing this.
VITE_API_ORIGIN=http://localhost:8000

# Everything else goes through this, with /api already on it.
VITE_API_URL=http://localhost:8000/api
